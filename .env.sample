# Sample environment — copy to .env.dev and fill in your values.
# .env.dev is gitignored; this file documents every variable the app reads.
NODE_ENV=development
PORT=3232
HOST=0.0.0.0
DATABASE_PATH=./data/app.db
# Required in production (32+ chars). Dev fallback exists only outside production.
SESSION_SECRET=change-me-to-a-long-random-string-32-chars-min
COOKIE_SECURE=false
# Dev-only stub login: POST /api/auth/dev-login {"user":"alice"} (forced off in production).
DEV_LOGIN=true
TRUST_PROXY=true
# Server-side Google key (never sent to the browser). Empty = proxy returns 503.
GOOGLE_PLACES_KEY=
# Map tiles (web build/dev only, VITE_ prefix required). Comma-separated
# raster tile URL template. Defaults to OSM standard tiles (no key).
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# Public origin of the app (scheme + host + port, no trailing slash).
# The OIDC callback is derived from it: ${APP_ORIGIN}/api/auth/callback.
# One value to change per deployment.
APP_ORIGIN=http://localhost:3232
# Uncomment for real login:
# OIDC_ISSUER=https://id.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Explicit override (must exactly match the value registered at the provider).
# Defaults to ${APP_ORIGIN}/api/auth/callback when empty.
# OIDC_REDIRECT_URI=
# Places API (M2M service auth for /api/places only). Resource is the exact
# `aud` minted by Pocket ID — immutable once created in Pocket ID.
# Empty = M2M Bearer disabled (all Bearer calls 401).
# Tokens are verified against ${OIDC_ISSUER}/.well-known/jwks.json.
# PLACES_API_RESOURCE=https://places.1001-restaurants.homelab
