#!/bin/sh
# commit-msg hook: enforce Conventional Commits.
# Allowed: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert
#   (+ optional scope): subject, e.g. "feat(api): paginate places"
# Bypass (not recommended): CONVENTIONAL_DISABLE=1 git commit ...
if [ "${CONVENTIONAL_DISABLE:-}" = "1" ]; then
  echo "[conventional] skipped (CONVENTIONAL_DISABLE=1)"
  exit 0
fi
MSG_FILE="$1"
SUBJECT="$(head -n 1 "$MSG_FILE")"
# Allow merge/revert commits generated by git.
case "$SUBJECT" in
  "Merge "*|"Revert "* ) exit 0;;
esac
if printf '%s' "$SUBJECT" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9_.-]+\))?(!)?: [^ ].+'; then
  exit 0
fi
echo "[conventional] commit blocked: subject must match Conventional Commits." >&2
echo "  got:      $SUBJECT" >&2
echo "  expected: <type>(<scope>)?: <subject>" >&2
echo "  types: feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert" >&2
echo "  example: feat(api): paginate places with cursor" >&2
exit 1
